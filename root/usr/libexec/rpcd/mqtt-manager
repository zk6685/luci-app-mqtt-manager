#!/bin/sh
# rpcd JSON-RPC wrapper for mqtt-manager
# Receives JSON-RPC request on stdin, dispatches to mqtt-manager.sh, returns JSON.
# JS side: rpc.declare({object:'mqtt-manager', method:'exec', params:['args']})
#   callRpc('["status"]')  -> rpcd receives params { args: '["status"]' }

. /usr/share/libubox/jshn.sh

INPUT=$(cat)

json_init
json_load "$INPUT"
json_get_var method method

# rpcd capability discovery: expose the single 'exec' method
if [ "$method" = "list" ]; then
	echo '{"exec":{"call":true}}'
	exit 0
fi

# method is always 'exec' from JS. Real command lives in args JSON array.
json_get_var args args

# Parse args JSON array ("[\"status\",\"zk6685\"]") into positional params.
set --
if [ -n "$args" ] && [ "$args" != "null" ]; then
	json_init
	json_load "$args"
	i=1
	while json_get_var v "$i"; do
		set -- "$@" "$v"
		i=$((i+1))
	done
fi

# $1 = command name, rest = its arguments
OUTPUT=$(/usr/bin/mqtt-manager.sh "$@" 2>&1)
RC=$?

# JSON-encode output (escape backslash, quote; newlines -> \n)
ESCAPED=$(printf '%s' "$OUTPUT" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{ printf "%s\\n", $0 }')
echo "{\"result\":\"$ESCAPED\",\"code\":$RC}"
